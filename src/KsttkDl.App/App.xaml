<Application x:Class="KsttkDl.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:KsttkDl.App.Infrastructure"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- slot 0 holds the light or dark tokens and is swapped by ThemeManager -->
                <ResourceDictionary Source="Theme/Light.xaml" />
                <ResourceDictionary Source="Theme/Harbour.xaml" />
                <ResourceDictionary Source="Theme/Ornaments.xaml" />
                <ResourceDictionary Source="Theme/Pages.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <infra:PresenceConverter x:Key="Presence" />
            <infra:MatchConverter x:Key="Match" />
            <infra:EqualsConverter x:Key="Equals" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
