<UserControl x:Class="KsttkDl.App.Views.MapsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KsttkDl.App.ViewModels"
             xmlns:c="clr-namespace:KsttkDl.App.Controls"
             xmlns:views="clr-namespace:KsttkDl.App.Views">
    <Grid>
        <Grid Margin="28,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Text="海域" Style="{StaticResource Text.Title}" />
                <TextBlock Text="Maps" Style="{StaticResource Text.Heading}" Margin="12,0,0,3" VerticalAlignment="Bottom"
                           Foreground="{DynamicResource Brush.InkSoft}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ContentControl Style="{StaticResource Paper}" Padding="6">
                    <ListBox ItemsSource="{Binding Maps}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Maps"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MapItem}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Code}" FontFamily="{DynamicResource Font.Heading}" FontSize="16"
                                               FontWeight="Bold" Foreground="{DynamicResource Brush.TealText}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Brush.InkFaint}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ContentControl>

                <Grid Grid.Column="1" Margin="20,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button Content="Open folder" Command="{Binding OpenFolder}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Heading}" FontSize="22">
                                <Run Text="{Binding Selected.Code, Mode=OneWay}" />
                                <Run Text="{Binding Selected.Title, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Teal}" BorderThickness="1" CornerRadius="3"
                            Background="{DynamicResource Brush.PanelAlt}" VerticalAlignment="Top">
                        <Grid>
                            <Image c:ImageLoader.Path="{Binding Selected.ImagePath}" Stretch="Uniform" MaxHeight="760"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <ContentControl Style="{StaticResource Stamp}" Content="未" Width="56" Height="56" Margin="60"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding Selected.HasImage, Converter={StaticResource Presence}, ConverterParameter=invert}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <views:EmptyState Visibility="{Binding HasData, Converter={StaticResource Presence}, ConverterParameter=invert}" />
    </Grid>
</UserControl>
