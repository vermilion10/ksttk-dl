<UserControl x:Class="KsttkDl.App.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KsttkDl.App.ViewModels"
             xmlns:core="clr-namespace:KsttkDl.Core.MasterData;assembly=KsttkDl.Core">
    <Grid Margin="28,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="同期" Style="{StaticResource Text.Title}" />
            <TextBlock Text="Sync" Style="{StaticResource Text.Heading}" Margin="12,0,0,3" VerticalAlignment="Bottom"
                       Foreground="{DynamicResource Brush.InkSoft}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <!-- game data and world -->
                <ContentControl Style="{StaticResource Paper}">
                    <StackPanel>
                        <TextBlock Text="GAME DATA" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding DataStatus}" Style="{StaticResource Text.Body}" Margin="0,6,0,0" />
                        <Button Style="{StaticResource Button.Primary}" Content="Get latest game data" Command="{Binding RefreshData}"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                ToolTip="Master data and English names from the community data files" />

                        <TextBlock Text="WORLD" Style="{StaticResource Text.Label}" Margin="0,18,0,0" />
                        <ComboBox ItemsSource="{Binding Worlds}" SelectedItem="{Binding World}" Margin="0,6,0,0"
                                  MaxDropDownHeight="360" AutomationProperties.Name="World"
                                  IsEnabled="{Binding HasData}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:WorldServer}">
                                    <TextBlock>
                                        <Run Text="{Binding Num, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="  " />
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Assets are the same on every world; pick any that answers." Style="{StaticResource Text.Caption}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </ContentControl>

                <!-- the route to Japan -->
                <ContentControl Style="{StaticResource Paper}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="CONNECTION" Style="{StaticResource Text.Label}" />
                        <TextBlock Text="{Binding NetworkMode}" Style="{StaticResource Text.Body}" Margin="0,6,0,0" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding NetworkHint}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="Test connection" Command="{Binding TestNetwork}" Margin="0,0,8,6" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Switch relay" Command="{Binding SwitchRelay}"
                                    Margin="0,0,0,6" ToolTip="Use the next best Japanese relay; the CDN will see a new address" />
                        </WrapPanel>
                        <TextBlock Text="{Binding NetworkResult}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                </ContentControl>
            </StackPanel>

            <!-- categories -->
            <ContentControl Grid.Column="1" Style="{StaticResource Paper}" Margin="16,0,0,0" Padding="18,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Ghost}" Content="Stop" Command="{Binding Cancel}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Organize output" Command="{Binding Extract}" Margin="0,0,8,0"
                                    ToolTip="Copy everything downloaded into named folders, as 'ksttk-dl extract' does" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Open output" Command="{Binding OpenOutput}" Margin="0,0,8,0" />
                            <Button Content="Download all" Command="{Binding DownloadAll}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="EVERYTHING AT ONCE" Style="{StaticResource Text.Label}" />
                            <TextBlock Text="Browsing fetches only what you open. Download a whole category here."
                                       Style="{StaticResource Text.Caption}" Margin="0,4,12,0" />
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,0,-12,0" Padding="0,0,12,0">
                    <ItemsControl ItemsSource="{Binding Categories}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CategoryRow}">
                                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="40" Height="40" HorizontalAlignment="Left">
                                            <Ellipse Fill="{DynamicResource Brush.Accent}" />
                                            <TextBlock Text="{Binding Kanji}" FontFamily="{DynamicResource Font.Heading}" FontSize="18"
                                                       FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Counts}" DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" Margin="0,1,0,6" />
                                            <ProgressBar Maximum="1" Value="{Binding Progress, Mode=OneWay}" />
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                                       Visibility="{Binding Status, Converter={StaticResource Presence}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                            <Grid Width="40" Margin="0,0,10,0">
                                                <ContentControl Style="{StaticResource Stamp}" Content="{Binding Stamp}"
                                                                Visibility="{Binding Stamp, Converter={StaticResource Presence}}" />
                                            </Grid>
                                            <Button Content="Download" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.Download, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </ContentControl>
        </Grid>

        <!-- 電信 the telegraph tape -->
        <Border Grid.Row="2" Margin="0,14,0,0" Background="{DynamicResource Brush.LogBg}" CornerRadius="3"
                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="電信  LOG" Style="{StaticResource Text.Label}" Margin="12,8,0,2" />
                <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Services.Log}" Margin="4,0,4,4"
                         FontFamily="{DynamicResource Font.Mono}" FontSize="11.5" Foreground="{DynamicResource Brush.LogInk}"
                         VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Log">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,1" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.LogInk}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
