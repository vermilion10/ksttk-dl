<UserControl x:Class="KsttkDl.App.Views.RoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KsttkDl.App.ViewModels"
             xmlns:c="clr-namespace:KsttkDl.App.Controls"
             xmlns:room="clr-namespace:KsttkDl.Core.Room;assembly=KsttkDl.Core"
             xmlns:views="clr-namespace:KsttkDl.App.Views"
             Focusable="True">
    <UserControl.InputBindings>
        <KeyBinding Key="Left" Command="{Binding Nudge}" CommandParameter="Left" />
        <KeyBinding Key="Right" Command="{Binding Nudge}" CommandParameter="Right" />
        <KeyBinding Key="Up" Command="{Binding Nudge}" CommandParameter="Up" />
        <KeyBinding Key="Down" Command="{Binding Nudge}" CommandParameter="Down" />
        <KeyBinding Key="Left" Modifiers="Shift" Command="{Binding Nudge}" CommandParameter="Left" />
        <KeyBinding Key="Right" Modifiers="Shift" Command="{Binding Nudge}" CommandParameter="Right" />
        <KeyBinding Key="Up" Modifiers="Shift" Command="{Binding Nudge}" CommandParameter="Up" />
        <KeyBinding Key="Down" Modifiers="Shift" Command="{Binding Nudge}" CommandParameter="Down" />
    </UserControl.InputBindings>

    <Grid>
        <Grid Margin="28,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- header and the room's own toolbar -->
            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" Width="170" Margin="0,0,8,0"
                              AutomationProperties.Name="Saved rooms" ToolTip="Load a saved room">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type room:RoomPreset}">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid Width="150" Margin="0,0,8,0">
                        <TextBox x:Name="NameBox" Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Room name" />
                        <TextBlock Text="Room name" Style="{StaticResource Text.Caption}" Margin="10,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=NameBox, Converter={StaticResource Presence}, ConverterParameter=invert}" />
                    </Grid>
                    <Button Style="{StaticResource Button.Ghost}" Content="Save" Command="{Binding SavePreset}" Margin="0,0,6,0" />
                    <Button Style="{StaticResource Button.Ghost}" Content="Delete" Command="{Binding DeletePreset}" Margin="0,0,14,0" />
                    <Button Style="{StaticResource Button.Ghost}" Content="Randomize" Command="{Binding Randomize}" Margin="0,0,8,0" />
                    <Button Content="Export 2×" Command="{Binding Export}" CommandParameter="2" Margin="0,0,8,0"
                            ToolTip="2400×1440 PNG" />
                    <Button Style="{StaticResource Button.Primary}" Content="Export PNG" Command="{Binding Export}" CommandParameter="1"
                            ToolTip="1200×720 PNG, as the game draws it" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="部屋" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="Room" Style="{StaticResource Text.Heading}" Margin="12,0,0,3" VerticalAlignment="Bottom"
                               Foreground="{DynamicResource Brush.InkSoft}" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <!-- layers, top of the stack first -->
                <ContentControl Style="{StaticResource Paper}" Padding="10,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="LAYERS" Style="{StaticResource Text.Label}" Margin="6,0,0,6" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding Layers}" SelectedItem="{Binding Selected}"
                                 AutomationProperties.Name="Layers">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RoomLayer}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding Visible}" VerticalAlignment="Center"
                                                  AutomationProperties.Name="{Binding Label, StringFormat=Show {0}}" ToolTip="Show or hide" />
                                        <Grid Grid.Column="1" Width="28" Height="28" Margin="8,0,8,0">
                                            <Ellipse Fill="{DynamicResource Brush.Accent}" />
                                            <TextBlock Text="{Binding Kanji}" FontFamily="{DynamicResource Font.Heading}" FontWeight="Bold"
                                                       FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Caption}" FontSize="11" Foreground="{DynamicResource Brush.InkFaint}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- the chosen layer's edits -->
                        <StackPanel Grid.Row="2" Margin="6,10,6,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}"
                                           Text="{Binding Selected.Opacity, StringFormat={}{0:P0}}" />
                                <TextBlock Text="Opacity" Style="{StaticResource Text.Caption}" />
                            </DockPanel>
                            <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Margin="0,4,0,8"
                                    Value="{Binding Selected.Opacity}" AutomationProperties.Name="Layer opacity" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}"
                                           Text="{Binding Selected.Scale, StringFormat={}{0:P0}}" />
                                <TextBlock Text="Size" Style="{StaticResource Text.Caption}" />
                            </DockPanel>
                            <Slider Minimum="0.25" Maximum="3" SmallChange="0.01" LargeChange="0.1" Margin="0,4,0,8"
                                    Value="{Binding Selected.Scale}" AutomationProperties.Name="Layer size" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}">
                                    <Run Text="{Binding Selected.OffsetX, Mode=OneWay}" />
                                    <Run Text="," />
                                    <Run Text="{Binding Selected.OffsetY, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="Moved by" Style="{StaticResource Text.Caption}" />
                            </DockPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource Button.Ghost}" Content="Reset layer" Command="{Binding ResetLayer}"
                                        Margin="0,0,6,6" />
                                <Button Style="{StaticResource Button.Ghost}" Content="Reset all" Command="{Binding ResetAll}" Margin="0,0,0,6" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" FontSize="11" Margin="0,4,0,0"
                                       Text="Drag on the room to move the chosen layer. Arrow keys move it 1 px, with Shift 10 px." />
                        </StackPanel>
                    </Grid>
                </ContentControl>

                <!-- the room -->
                <Grid Grid.Column="1" Margin="16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource Brush.Teal}" BorderThickness="1" Background="Black" VerticalAlignment="Center"
                            CornerRadius="2" Padding="0">
                        <Viewbox Stretch="Uniform">
                            <Canvas x:Name="RoomCanvas" Width="1200" Height="720" ClipToBounds="True" Background="Black"
                                    Cursor="SizeAll" MouseLeftButtonDown="Room_MouseDown" MouseMove="Room_MouseMove"
                                    MouseLeftButtonUp="Room_MouseUp">
                                <ItemsControl ItemsSource="{Binding Layers}" Width="1200" Height="720" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:RoomLayer}">
                                            <ItemsControl ItemsSource="{Binding Sprites}" Opacity="{Binding Opacity}" Focusable="False"
                                                          Visibility="{Binding Visible, Converter={StaticResource BoolToVisibility}}">
                                                <ItemsControl.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}"
                                                                        CenterX="{Binding CentreX}" CenterY="{Binding CentreY}" />
                                                        <TranslateTransform X="{Binding OffsetX}" Y="{Binding OffsetY}" />
                                                    </TransformGroup>
                                                </ItemsControl.RenderTransform>
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="1200" Height="720" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:SpriteImage}">
                                                        <Image Source="{Binding Image}" Width="{Binding Width}" Height="{Binding Height}"
                                                               Opacity="{Binding Opacity}" Stretch="Fill"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <DockPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Text="1200 × 720, placed as the game client places it" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" />
                    </DockPanel>
                </Grid>

                <!-- the picker for the chosen layer -->
                <ContentControl Grid.Column="2" Style="{StaticResource Paper}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding PickerTitle}" Style="{StaticResource Text.Heading}" Margin="2,0,0,10" />

                        <!-- furniture for the chosen slot -->
                        <ItemsControl Grid.Row="1" Style="{StaticResource GalleryList}" ItemsSource="{Binding Gallery.Rows}"
                                      Visibility="{Binding PickerMode, Converter={StaticResource Match}, ConverterParameter=Furniture}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Items}" Loaded="FurnitureRow_Loaded" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:EntityTile}">
                                                <Button Style="{StaticResource TileButton}" Width="88" Margin="0,0,8,10" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.PickFurniture, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}">
                                                    <StackPanel>
                                                        <Border Style="{StaticResource Placeholder}" Height="96" BorderBrush="{DynamicResource Brush.Line}"
                                                                BorderThickness="1">
                                                            <Image c:ImageLoader.DecodeWidth="120" c:ImageLoader.Path="{Binding ImagePath}"
                                                                   Stretch="Uniform" Margin="3" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontSize="10.5" Margin="1,4,1,0"
                                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.InkSoft}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- the secretary -->
                        <Grid Grid.Row="1" Visibility="{Binding PickerMode, Converter={StaticResource Match}, ConverterParameter=Ship}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBox x:Name="ShipSearch" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                         AutomationProperties.Name="Search ships" />
                                <TextBlock Text="Search ships" Style="{StaticResource Text.Caption}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=ShipSearch, Converter={StaticResource Presence}, ConverterParameter=invert}" />
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,10,0,10">
                                <TextBlock Text="CG" Style="{StaticResource Text.Label}" Margin="2,0,0,4" />
                                <ListBox ItemsSource="{Binding Arts}" SelectedValuePath="Key" SelectedValue="{Binding Art}"
                                         MaxHeight="150" AutomationProperties.Name="Secretary CG">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                            <Setter Property="ToolTip" Value="{Binding Note}" />
                                            <Setter Property="Padding" Value="8,4" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type room:SecretaryArt}">
                                            <TextBlock Text="{Binding Label}" FontSize="12" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <CheckBox IsChecked="{Binding LeftOfCentre}" Content="Stand left of centre" Margin="0,8,0,0" />
                            </StackPanel>
                            <ItemsControl Grid.Row="2" Style="{StaticResource GalleryList}" ItemsSource="{Binding ShipGallery.Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Items}" Loaded="ShipRow_Loaded" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:ShipTile}">
                                                    <Button Style="{StaticResource TileButton}" Width="88" Margin="0,0,8,10" CommandParameter="{Binding}"
                                                            Command="{Binding DataContext.PickShip, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Title}">
                                                        <StackPanel>
                                                            <Border Background="{Binding Frame}" CornerRadius="3" Padding="2">
                                                                <Grid Height="117">
                                                                    <Border Style="{StaticResource Placeholder}" />
                                                                    <Image c:ImageLoader.DecodeWidth="110" c:ImageLoader.Path="{Binding ImagePath}"
                                                                           Stretch="Uniform" />
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}" FontSize="10.5" Margin="1,4,1,0"
                                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.InkSoft}" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- the port interface -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      DataContext="{Binding PortUi}"
                                      Visibility="{Binding DataContext.PickerMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Match}, ConverterParameter=PortUi}">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="SKIN" Style="{StaticResource Text.Label}" Margin="2,0,0,4" />
                                <WrapPanel Margin="0,0,0,8">
                                    <RadioButton Style="{StaticResource RadioChip}" Content="1" GroupName="Skin" ToolTip="Skin 1"
                                                 IsChecked="{Binding Skin, Converter={StaticResource Equals}, ConverterParameter=Skin1}" />
                                    <RadioButton Style="{StaticResource RadioChip}" Content="1 classic" GroupName="Skin"
                                                 ToolTip="Skin 1 with the fleet count, as the port first looked"
                                                 IsChecked="{Binding Skin, Converter={StaticResource Equals}, ConverterParameter=Classic}" />
                                    <RadioButton Style="{StaticResource RadioChip}" Content="2" GroupName="Skin" ToolTip="Skin 2"
                                                 IsChecked="{Binding Skin, Converter={StaticResource Equals}, ConverterParameter=Skin2}" />
                                    <RadioButton Style="{StaticResource RadioChip}" Content="3" GroupName="Skin" ToolTip="Skin 3"
                                                 IsChecked="{Binding Skin, Converter={StaticResource Equals}, ConverterParameter=Skin3}" />
                                    <RadioButton Style="{StaticResource RadioChip}" Content="3 改" GroupName="Skin" ToolTip="Skin 3 改"
                                                 IsChecked="{Binding Skin, Converter={StaticResource Equals}, ConverterParameter=Skin3Kai}" />
                                </WrapPanel>

                                <TextBlock Text="ADMIRAL" Style="{StaticResource Text.Label}" Margin="2,4,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Name" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="Admiral name"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                    <TextBlock Grid.Row="1" Text="HQ level" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="HQ level"
                                             Text="{Binding Level, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                    <TextBlock Grid.Row="2" Text="Rank" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="Rank"
                                              ItemsSource="{Binding Ranks}" SelectedItem="{Binding Rank}" />
                                    <TextBlock Grid.Row="3" Text="Fleets" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                                               Visibility="{Binding HasFleets, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" AutomationProperties.Name="Fleets"
                                             Visibility="{Binding HasFleets, Converter={StaticResource BoolToVisibility}}"
                                             Text="{Binding Fleets, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                    <TextBlock Grid.Row="4" Text="Ships / max" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                                    <UniformGrid Grid.Row="4" Grid.Column="1" Columns="2" Margin="0,0,0,6">
                                        <TextBox Margin="0,0,4,0" AutomationProperties.Name="Ships"
                                                 Text="{Binding Ships, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                        <TextBox Margin="4,0,0,0" AutomationProperties.Name="Ship capacity"
                                                 Text="{Binding ShipMax, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                    </UniformGrid>
                                    <TextBlock Grid.Row="5" Text="Equipment / max" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                                               Visibility="{Binding HasScrews, Converter={StaticResource BoolToVisibility}}" />
                                    <UniformGrid Grid.Row="5" Grid.Column="1" Columns="2" Margin="0,0,0,6"
                                                 Visibility="{Binding HasScrews, Converter={StaticResource BoolToVisibility}}">
                                        <TextBox Margin="0,0,4,0" AutomationProperties.Name="Equipment"
                                                 Text="{Binding Equipment, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                        <TextBox Margin="4,0,0,0" AutomationProperties.Name="Equipment capacity"
                                                 Text="{Binding EquipmentMax, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                    </UniformGrid>
                                </Grid>

                                <TextBlock Text="RESOURCES" Style="{StaticResource Text.Label}" Margin="2,6,0,4" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,4,6">
                                        <TextBlock Text="Fuel 燃料" Style="{StaticResource Text.Caption}" />
                                        <TextBox AutomationProperties.Name="Fuel" Text="{Binding Fuel, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,6">
                                        <TextBlock Text="Ammo 弾薬" Style="{StaticResource Text.Caption}" />
                                        <TextBox AutomationProperties.Name="Ammo" Text="{Binding Ammo, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,4,6">
                                        <TextBlock Text="Steel 鋼材" Style="{StaticResource Text.Caption}" />
                                        <TextBox AutomationProperties.Name="Steel" Text="{Binding Steel, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,6">
                                        <TextBlock Text="Bauxite ボーキ" Style="{StaticResource Text.Caption}" />
                                        <TextBox AutomationProperties.Name="Bauxite" Text="{Binding Bauxite, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,4,6">
                                        <TextBlock Text="Buckets 高速修復材" Style="{StaticResource Text.Caption}" />
                                        <TextBox AutomationProperties.Name="Buckets" Text="{Binding Buckets, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,6">
                                        <TextBlock Text="Dev. mats 開発資材" Style="{StaticResource Text.Caption}" />
                                        <TextBox AutomationProperties.Name="Development materials"
                                                 Text="{Binding DevMaterials, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,4,6" Visibility="{Binding HasScrews, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Screws 改修資材" Style="{StaticResource Text.Caption}" />
                                        <TextBox AutomationProperties.Name="Improvement materials"
                                                 Text="{Binding Screws, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="CLOCK" Style="{StaticResource Text.Label}" Margin="2,6,0,4" />
                                <CheckBox IsChecked="{Binding ShowClock}" Content="Show the clock" Margin="0,0,0,6" />
                                <CheckBox IsChecked="{Binding LiveClock}" Content="Follow this computer's time" Margin="0,0,0,6" />
                                <UniformGrid Columns="2" IsEnabled="{Binding LiveClock, Converter={StaticResource Equals}, ConverterParameter=False}">
                                    <StackPanel Margin="0,0,4,6">
                                        <TextBlock Text="Date (MM/DD)" Style="{StaticResource Text.Caption}" />
                                        <TextBox AutomationProperties.Name="Clock date" Text="{Binding Date, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                    </StackPanel>
                                    <StackPanel Margin="4,0,0,6">
                                        <TextBlock Text="Time (HH:MM)" Style="{StaticResource Text.Caption}" />
                                        <TextBox AutomationProperties.Name="Clock time" Text="{Binding Time, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                                    </StackPanel>
                                </UniformGrid>

                                <CheckBox IsChecked="{Binding FriendFleetEvent}" Content="Friend fleet event button" Margin="0,6,0,8" />
                                <TextBlock Style="{StaticResource Text.Caption}" FontSize="11" TextWrapping="Wrap"
                                           Text="Text is set in the game's font, A-OTF UD Shin Go Pro, which downloads with the interface sheets." />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- the view outside -->
                        <StackPanel Grid.Row="1" Visibility="{Binding PickerMode, Converter={StaticResource Match}, ConverterParameter=Outside}">
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,10"
                                       Text="The window decides the scenery; the time of day picks the light. The game follows the clock." />
                            <WrapPanel>
                                <RadioButton Style="{StaticResource RadioChip}" Content="朝 Dawn" GroupName="Time"
                                             IsChecked="{Binding Time, Converter={StaticResource Equals}, ConverterParameter=Dawn}" />
                                <RadioButton Style="{StaticResource RadioChip}" Content="昼 Day" GroupName="Time"
                                             IsChecked="{Binding Time, Converter={StaticResource Equals}, ConverterParameter=Day}" />
                                <RadioButton Style="{StaticResource RadioChip}" Content="夕 Evening" GroupName="Time"
                                             IsChecked="{Binding Time, Converter={StaticResource Equals}, ConverterParameter=Evening}" />
                                <RadioButton Style="{StaticResource RadioChip}" Content="暮 Dusk" GroupName="Time"
                                             IsChecked="{Binding Time, Converter={StaticResource Equals}, ConverterParameter=Dusk}" />
                                <RadioButton Style="{StaticResource RadioChip}" Content="夜 Night" GroupName="Time"
                                             IsChecked="{Binding Time, Converter={StaticResource Equals}, ConverterParameter=Night}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </ContentControl>
            </Grid>
        </Grid>

        <views:EmptyState Visibility="{Binding HasData, Converter={StaticResource Presence}, ConverterParameter=invert}" />
    </Grid>
</UserControl>
