<UserControl x:Class="KsttkDl.App.Views.CollectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KsttkDl.App.ViewModels"
             xmlns:c="clr-namespace:KsttkDl.App.Controls"
             xmlns:views="clr-namespace:KsttkDl.App.Views">
    <Grid>
        <Grid Margin="28,20,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding Kanji}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.Heading}" Margin="12,0,0,3" VerticalAlignment="Bottom"
                               Foreground="{DynamicResource Brush.InkSoft}" />
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" Margin="14,0,0,5" VerticalAlignment="Bottom" />
                </StackPanel>
                <Grid Grid.Column="1" Width="260" VerticalAlignment="Bottom">
                    <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             AutomationProperties.Name="Search" />
                    <TextBlock Text="Search name or id" Style="{StaticResource Text.Caption}" Margin="10,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource Presence}, ConverterParameter=invert}" />
                </Grid>
            </Grid>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Groups}" Margin="0,0,18,8" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:Filter}">
                        <ToggleButton Style="{StaticResource Chip}" Content="{Binding Label}" IsChecked="{Binding On}"
                                      Command="{Binding DataContext.ApplyFilters, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Grid.Row="2" Style="{StaticResource GalleryList}" ItemsSource="{Binding Gallery.Rows}"
                          SizeChanged="Tiles_SizeChanged">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding Items}" Loaded="Row_Loaded" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:EntityTile}">
                                    <Button Style="{StaticResource TileButton}" Width="164" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.Open, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            AutomationProperties.Name="{Binding Title}">
                                        <StackPanel>
                                            <Border Style="{StaticResource Placeholder}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                                                    Height="{Binding DataContext.TileHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <Grid>
                                                    <Rectangle Fill="{DynamicResource Brush.Honeycomb}" />
                                                    <Image c:ImageLoader.DecodeWidth="200" c:ImageLoader.Path="{Binding ImagePath}"
                                                           Stretch="Uniform" Margin="4" />
                                                    <ContentControl Style="{StaticResource Stamp}" Content="欠" HorizontalAlignment="Right"
                                                                    VerticalAlignment="Bottom" Margin="0,0,6,6"
                                                                    Visibility="{Binding Absent, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="2,6,2,0"
                                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Ink}" />
                                            <TextBlock Text="{Binding Subtitle}" Margin="2,1,2,0" FontSize="11"
                                                       Foreground="{DynamicResource Brush.InkFaint}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <views:EmptyState Visibility="{Binding HasData, Converter={StaticResource Presence}, ConverterParameter=invert}" />

        <ContentControl Content="{Binding Detail}" Focusable="False" Visibility="{Binding Detail, Converter={StaticResource Presence}}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type vm:EntityDetailViewModel}">
                    <Grid Background="{DynamicResource Brush.WindowBg}">
                        <Rectangle Fill="{DynamicResource Brush.Honeycomb}" />
                        <Grid Margin="20,16,24,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>
                            <Grid Margin="0,0,20,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Image c:ImageLoader.Path="{Binding Selected.ImagePath}" Stretch="Uniform" StretchDirection="Both"
                                       MaxWidth="900" Margin="20" RenderOptions.BitmapScalingMode="HighQuality" />
                                <ListBox Grid.Row="1" Style="{StaticResource ThumbStrip}" ItemsSource="{Binding Images}"
                                         SelectedItem="{Binding Selected}" Height="136" AutomationProperties.Name="Pictures">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ImageAsset}">
                                            <StackPanel Width="96">
                                                <Border Style="{StaticResource Placeholder}" Height="80">
                                                    <Image c:ImageLoader.DecodeWidth="120" c:ImageLoader.Path="{Binding ImagePath}"
                                                           Stretch="Uniform" Margin="3" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Brush.InkSoft}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                            <ContentControl Grid.Column="1" Style="{StaticResource Paper}" Padding="20,16" VerticalAlignment="Top">
                                <StackPanel>
                                    <Button Style="{StaticResource Button.Ghost}" Content="← 戻る Back" Command="{Binding Close}"
                                            HorizontalAlignment="Left" IsCancel="True" />
                                    <TextBlock Text="{Binding Tile.Subtitle}" Style="{StaticResource Text.Label}" Margin="0,18,0,0" />
                                    <TextBlock Text="{Binding Tile.Title}" Style="{StaticResource Text.Title}" FontSize="24"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <Rectangle Height="1" Fill="{DynamicResource Brush.GoldSoft}" Margin="0,12,0,10" />
                                    <TextBlock Text="{Binding Facts}" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="{Binding Tile.Description}" Style="{StaticResource Text.Body}" Margin="0,12,0,0"
                                               Visibility="{Binding Tile.Description, Converter={StaticResource Presence}}" />
                                    <Button Content="Show in folder" ToolTip="Open the folder with this file selected" Command="{Binding OpenFolder}" HorizontalAlignment="Left" Margin="0,18,0,0" />
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                                </StackPanel>
                            </ContentControl>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>
</UserControl>
