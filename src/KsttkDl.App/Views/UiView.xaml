<UserControl x:Class="KsttkDl.App.Views.UiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KsttkDl.App.ViewModels"
             xmlns:c="clr-namespace:KsttkDl.App.Controls"
             xmlns:views="clr-namespace:KsttkDl.App.Views">
    <Grid>
        <Grid Margin="28,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Download section" Command="{Binding DownloadSection}" VerticalAlignment="Bottom"
                        ToolTip="Download every file in this section" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="画面" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="UI" Style="{StaticResource Text.Heading}" Margin="12,0,0,3" VerticalAlignment="Bottom"
                               Foreground="{DynamicResource Brush.InkSoft}" />
                </StackPanel>
            </DockPanel>

            <!-- screens, as the client groups its sheets -->
            <ListBox Grid.Row="1" ItemsSource="{Binding Sections}" SelectedItem="{Binding Section}" Margin="0,0,0,12"
                     Background="Transparent" BorderThickness="0" AutomationProperties.Name="Screens"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ToggleButton Style="{StaticResource Chip}" Content="{Binding Title}" Focusable="False"
                                                  IsChecked="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- the section's files by raw path -->
                <ContentControl Style="{StaticResource Paper}" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                     AutomationProperties.Name="Filter by name or path" />
                            <TextBlock Text="Filter by name or path" Style="{StaticResource Text.Caption}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource Presence}, ConverterParameter=invert}" />
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                                 AutomationProperties.Name="Files" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:UiItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding RawPath}" FontSize="10.5" FontFamily="Consolas"
                                                       Foreground="{DynamicResource Brush.InkFaint}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding RawPath}" />
                                        </StackPanel>
                                        <ContentControl Grid.Column="1" Style="{StaticResource Stamp}" Content="{Binding Stamp}"
                                                        Width="26" Height="26" Margin="6,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource Text.Caption}" Margin="4,8,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </ContentControl>

                <!-- the chosen sheet and its frames -->
                <Grid Grid.Column="1" Margin="20,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Ghost}" Content="Copy path" Command="{Binding CopyPath}"
                                    CommandParameter="{Binding Selected}" Margin="0,0,6,0" />
                            <Button Content="Show in folder" Command="{Binding OpenFolder}" CommandParameter="{Binding Selected}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Selected.Title}" Style="{StaticResource Text.Heading}" FontSize="20" />
                            <TextBlock Text="{Binding Selected.RawPath}" FontFamily="Consolas" FontSize="12" Margin="0,3,0,0"
                                       Foreground="{DynamicResource Brush.InkSoft}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border BorderBrush="{DynamicResource Brush.Teal}" BorderThickness="1" CornerRadius="3" HorizontalAlignment="Left"
                                    Background="{DynamicResource Brush.PanelAlt}" Padding="4"
                                    Visibility="{Binding ImagePath, Converter={StaticResource Presence}}">
                                <Image c:ImageLoader.Path="{Binding ImagePath}" Stretch="Uniform" MaxHeight="420" StretchDirection="DownOnly"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock Text="FRAMES" Style="{StaticResource Text.Label}" Margin="2,14,0,6"
                                       Visibility="{Binding Frames.Count, Converter={StaticResource Presence}}" />
                            <ItemsControl ItemsSource="{Binding Frames}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:FrameTile}">
                                        <Border Width="132" Margin="0,0,8,8" Padding="6" CornerRadius="3"
                                                Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Line}"
                                                BorderThickness="1" ToolTip="{Binding Name}">
                                            <StackPanel>
                                                <Border Height="90" Style="{StaticResource Placeholder}">
                                                    <Image Source="{Binding Image}" Stretch="Uniform" StretchDirection="DownOnly" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontSize="10.5" Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Size}" FontSize="10" Foreground="{DynamicResource Brush.InkFaint}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <views:EmptyState Visibility="{Binding HasData, Converter={StaticResource Presence}, ConverterParameter=invert}" />
    </Grid>
</UserControl>
