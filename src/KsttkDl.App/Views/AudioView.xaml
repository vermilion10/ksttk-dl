<UserControl x:Class="KsttkDl.App.Views.AudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:KsttkDl.App.ViewModels"
             xmlns:views="clr-namespace:KsttkDl.App.Views">
    <Grid>
        <Grid Margin="28,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Content="Download section" Command="{Binding DownloadSection}" VerticalAlignment="Bottom"
                        ToolTip="Download every file in this section" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="音響" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="Audio" Style="{StaticResource Text.Heading}" Margin="12,0,0,3" VerticalAlignment="Bottom"
                               Foreground="{DynamicResource Brush.InkSoft}" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- kinds of sound -->
                <ContentControl Style="{StaticResource Paper}" Padding="6" VerticalAlignment="Top">
                    <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding Section}" AutomationProperties.Name="Sound kinds">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BrowserSection}">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="30" Height="30" Margin="0,0,10,0">
                                        <Ellipse Fill="{DynamicResource Brush.Accent}" />
                                        <TextBlock Text="{Binding Kanji}" FontFamily="{DynamicResource Font.Heading}" FontWeight="Bold"
                                                   FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ContentControl>

                <ContentControl Grid.Column="1" Style="{StaticResource Paper}" Padding="8" Margin="16,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8">
                            <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                     AutomationProperties.Name="Filter by name or path" />
                            <TextBlock Text="Filter by name or path" Style="{StaticResource Text.Caption}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource Presence}, ConverterParameter=invert}" />
                        </Grid>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Items}" AutomationProperties.Name="Sounds"
                                 VirtualizingPanel.ScrollUnit="Pixel" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AudioItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource PlayButton}" VerticalAlignment="Center" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.Play, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                AutomationProperties.Name="{Binding Title, StringFormat=Play {0}}">
                                            <Path x:Name="Glyph" Data="{StaticResource Geo.Play}" Fill="White" Margin="2,0,0,0" />
                                        </Button>
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0">
                                            <TextBlock FontSize="12.5" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource Brush.InkSoft}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding RawPath}" FontSize="10.5" FontFamily="Consolas"
                                                       Foreground="{DynamicResource Brush.InkFaint}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Button.Ghost}" Content="Copy path" Margin="0,0,6,0" Padding="10,3"
                                                    Command="{Binding DataContext.CopyPath, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title, StringFormat=Copy path of {0}}" />
                                            <Button Style="{StaticResource Button.Ghost}" Content="Folder" Margin="0,0,8,0" Padding="10,3"
                                                    Command="{Binding DataContext.OpenFolder, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title, StringFormat=Show {0} in folder}" />
                                            <ContentControl Style="{StaticResource Stamp}" Content="{Binding Stamp}" Width="26" Height="26" />
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Playing}" Value="True">
                                            <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Geo.Stop}" />
                                            <Setter TargetName="Glyph" Property="Margin" Value="0" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource Text.Caption}" Margin="4,8,0,0" />
                    </Grid>
                </ContentControl>
            </Grid>
        </Grid>

        <views:EmptyState Visibility="{Binding HasData, Converter={StaticResource Presence}, ConverterParameter=invert}" />
    </Grid>
</UserControl>
