<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- each section keeps its own colour, as the port menu does -->
    <RadialGradientBrush x:Key="Medal.Sync" GradientOrigin="0.35,0.3">
        <GradientStop Offset="0" Color="#48B7B1" />
        <GradientStop Offset="1" Color="#165E5B" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Medal.Ships" GradientOrigin="0.35,0.3">
        <GradientStop Offset="0" Color="#5A8FE0" />
        <GradientStop Offset="1" Color="#1D3F80" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Medal.Equipment" GradientOrigin="0.35,0.3">
        <GradientStop Offset="0" Color="#9A79D6" />
        <GradientStop Offset="1" Color="#45307A" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Medal.Furniture" GradientOrigin="0.35,0.3">
        <GradientStop Offset="0" Color="#C08A55" />
        <GradientStop Offset="1" Color="#5E3D1F" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Medal.Maps" GradientOrigin="0.35,0.3">
        <GradientStop Offset="0" Color="#7DBB5A" />
        <GradientStop Offset="1" Color="#2F5E22" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Medal.Room" GradientOrigin="0.35,0.3">
        <GradientStop Offset="0" Color="#D0645A" />
        <GradientStop Offset="1" Color="#6A221C" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Medal.Settings" GradientOrigin="0.35,0.3">
        <GradientStop Offset="0" Color="#98A0A3" />
        <GradientStop Offset="1" Color="#464C4F" />
    </RadialGradientBrush>

    <!-- a cog ring traced behind each medallion's characters -->
    <Geometry x:Key="Geo.Cog">M 30,4 L 33,9 L 39,7 L 40,13 L 46,14 L 45,20 L 51,23 L 48,28 L 53,32 L 48,36 L 51,41 L 45,44 L 46,50 L 40,51 L 39,57 L 33,55 L 30,60 L 27,55 L 21,57 L 20,51 L 14,50 L 15,44 L 9,41 L 12,36 L 7,32 L 12,28 L 9,23 L 15,20 L 14,14 L 20,13 L 21,7 L 27,9 Z M 30,20 A 12,12 0 1 0 30.01,20 Z</Geometry>

    <!-- 母港 medallion: Content is the kanji pair, Tag the English label, Background the section colour -->
    <Style x:Key="Medallion" TargetType="RadioButton">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Background="Transparent">
                        <Grid Width="62" Height="62" HorizontalAlignment="Center">
                            <Ellipse x:Name="Glow" Margin="-5" Fill="{DynamicResource Brush.Gold}" Opacity="0">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="8" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="Face" Fill="{TemplateBinding Background}" Opacity="0.82" />
                            <Ellipse Fill="{DynamicResource Brush.Honeycomb}" Opacity="0.9" />
                            <Path Data="{StaticResource Geo.Cog}" Fill="#22FFFFFF" Stretch="Uniform" Margin="6" />
                            <Ellipse x:Name="Ring" Stroke="#99FFFFFF" StrokeThickness="1.5" />
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="{DynamicResource Font.Heading}"
                                       FontSize="19" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.6" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>
                        <TextBlock x:Name="Label" Text="{TemplateBinding Tag}" FontSize="11" Margin="0,5,0,0"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource Brush.InkSoft}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Opacity" Value="1" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0.85" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Gold}" />
                            <Setter TargetName="Ring" Property="StrokeThickness" Value="2.5" />
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Gold}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 判 rubber stamp: 済 done, 未 not fetched, 欠 absent, 新 updated -->
    <Style x:Key="Stamp" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Vermilion}" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid RenderTransformOrigin="0.5,0.5" Opacity="0.88">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="-12" />
                        </Grid.RenderTransform>
                        <Ellipse Stroke="{TemplateBinding Foreground}" StrokeThickness="2.2" Fill="#14FFFFFF" />
                        <Ellipse Margin="3.5" Stroke="{TemplateBinding Foreground}" StrokeThickness="0.8" />
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{DynamicResource Font.Heading}"
                                   FontWeight="Bold" FontSize="15" Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- signal flag used on notices -->
    <Geometry x:Key="Geo.Flag">M 2,0 L 2,22 M 2,1 L 16,4 L 12,8 L 16,12 L 2,10</Geometry>

    <!-- the harbour sketch drawn behind the pages: gantry crane, warehouse, quay -->
    <Geometry x:Key="Geo.Harbour">M 0,300 L 640,300 M 40,300 L 40,210 L 190,210 L 190,300 M 40,210 L 115,175 L 190,210 M 60,300 L 60,250 L 85,250 L 85,300 M 110,235 L 130,235 L 130,255 L 110,255 Z M 150,235 L 170,235 L 170,255 L 150,255 Z M 300,300 L 330,80 L 360,300 M 306,255 L 354,255 M 313,205 L 347,205 M 320,150 L 340,150 M 306,255 L 347,205 M 354,255 L 313,205 M 313,205 L 340,150 M 347,205 L 320,150 M 250,80 L 560,80 L 560,95 L 250,95 Z M 270,80 L 330,40 L 400,80 M 330,40 L 330,80 M 300,80 L 300,95 M 360,80 L 360,95 M 420,80 L 420,95 M 480,80 L 480,95 M 520,95 L 520,170 M 512,170 L 528,170 L 524,182 L 516,182 Z M 250,95 L 230,120 L 270,120 Z M 420,300 L 640,300 L 640,285 L 420,285 Z M 450,285 L 470,265 L 600,265 L 615,285</Geometry>

</ResourceDictionary>
