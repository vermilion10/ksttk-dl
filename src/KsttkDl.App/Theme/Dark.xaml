<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 母港 Harbour Office, night: deep sea teal, charcoal shutters, warm lamplight -->
    <Color x:Key="Color.Bg">#0D2025</Color>
    <Color x:Key="Color.BgDeep">#081519</Color>
    <Color x:Key="Color.Teal">#2E8C87</Color>
    <Color x:Key="Color.TealDeep">#1E6763</Color>
    <Color x:Key="Color.TealLight">#46A9A3</Color>
    <Color x:Key="Color.Orange">#C7651F</Color>
    <Color x:Key="Color.OrangeLight">#E0823A</Color>

    <SolidColorBrush x:Key="Brush.Panel" Color="#16282C" />
    <SolidColorBrush x:Key="Brush.PanelAlt" Color="#1C3237" />
    <SolidColorBrush x:Key="Brush.Ink" Color="#ECE5D6" />
    <SolidColorBrush x:Key="Brush.InkSoft" Color="#B3BDB8" />
    <SolidColorBrush x:Key="Brush.InkFaint" Color="#82918D" />
    <SolidColorBrush x:Key="Brush.Teal" Color="{StaticResource Color.Teal}" />
    <SolidColorBrush x:Key="Brush.TealDeep" Color="{StaticResource Color.TealDeep}" />
    <SolidColorBrush x:Key="Brush.TealText" Color="#6CC9C2" />
    <SolidColorBrush x:Key="Brush.TealWash" Color="#262E8C87" />
    <SolidColorBrush x:Key="Brush.Gold" Color="#C4A465" />
    <SolidColorBrush x:Key="Brush.GoldSoft" Color="#55C4A465" />
    <SolidColorBrush x:Key="Brush.Orange" Color="{StaticResource Color.Orange}" />
    <SolidColorBrush x:Key="Brush.OrangeWash" Color="#33C7651F" />
    <SolidColorBrush x:Key="Brush.Vermilion" Color="#E0644F" />
    <SolidColorBrush x:Key="Brush.Line" Color="#2A4146" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Disabled" Color="#4A5A5D" />
    <SolidColorBrush x:Key="Brush.Rail" Color="#0A1A1E" />
    <SolidColorBrush x:Key="Brush.RailLine" Color="#24393E" />
    <SolidColorBrush x:Key="Brush.Watermark" Color="#1A6CC9C2" />
    <SolidColorBrush x:Key="Brush.Sketch" Color="#226CC9C2" />
    <SolidColorBrush x:Key="Brush.LogBg" Color="#0B191C" />
    <SolidColorBrush x:Key="Brush.LogInk" Color="#A9D6CF" />
    <SolidColorBrush x:Key="Brush.Shade" Color="#66000000" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="#AA081519" />

    <LinearGradientBrush x:Key="Brush.WindowBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#10282D" />
        <GradientStop Offset="1" Color="#081519" />
    </LinearGradientBrush>

    <DrawingBrush x:Key="Brush.Honeycomb" TileMode="Tile" Viewport="0,0,52,90" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing Geometry="M 0,15 L 26,0 L 52,15 L 52,45 L 26,60 L 0,45 Z M 26,60 L 26,90">
                <GeometryDrawing.Pen>
                    <Pen Brush="{StaticResource Brush.Watermark}" Thickness="1" />
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <LinearGradientBrush x:Key="Brush.Accent" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource Color.TealLight}" />
        <GradientStop Offset="0.55" Color="{StaticResource Color.Teal}" />
        <GradientStop Offset="1" Color="{StaticResource Color.TealDeep}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.AccentHover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#5CBDB7" />
        <GradientStop Offset="1" Color="{StaticResource Color.Teal}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.TealDeep}" />
    <LinearGradientBrush x:Key="Brush.Hot" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource Color.OrangeLight}" />
        <GradientStop Offset="1" Color="{StaticResource Color.Orange}" />
    </LinearGradientBrush>

</ResourceDictionary>
